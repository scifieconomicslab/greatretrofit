    "    wealth_pareto_alpha=1.5,\n",
    "    aspiration_mean=50,\n",
    "    aspiration_sd=15,\n",
    "    search_length=5,\n",
    "    n_neighbourhoods=4,\n",
    "    enable_bargaining=True,\n",
    "    max_bid_shade=0.2,\n",
    "    seller_reservation_pct=0.8,\n",
